; external perimeters extrusion width = 0.45mm
; perimeters extrusion width = 0.45mm
; infill extrusion width = 0.45mm
; solid infill extrusion width = 0.45mm
; top infill extrusion width = 0.42mm
; first layer extrusion width = 0.50mm

; EXECUTABLE_BLOCK_START
M486 S0
M486 AtankBottomv3_1_.stl_id_0_copy_0
M486 S-1
M73 P0 R135
M201 X7000 Y7000 Z200 E2500
M203 X400 Y400 Z12 E100
M204 P4000 R1200 T5000 ; sets acceleration (P, T) and retract acceleration (R), mm/sec^2
M205 X8.00 Y8.00 Z2.00 E10.00 ; sets the jerk limits, mm/sec
M205 J0.010
;TYPE:Custom
M17 ; enable steppers
M862.3 P "XL" ; printer model check
M115 U6.0.1+14848
G90 ; use absolute coordinates
M83 ; extruder relative mode
; set print area
M555 X75.092 Y101.8 W209.816 H156.4
; inform about nozzle diameter
M862.1 P0.4
; set & wait for bed and extruder temp for MBL
M140 S60 ; set bed temp
M104 T0 S170 ; set extruder temp for bed leveling
M109 T0 R170 ; wait for temp
; home carriage, pick tool, home all
G28 XY
M84 E ; turn off E motor
G28 Z
M190 S60 ; wait for bed temp
G29 G ; absorb heat
; move to the nozzle cleanup area
G1 X107.092 Y94.8 Z5 F4800
M302 S160 ; lower cold extrusion limit to 160C
G1 E-2 F2400 ; retraction for nozzle cleanup
M73 P3 R131
; nozzle cleanup
M84 E ; turn off E motor
G29 P9 X75.092 Y94.8 W32 H7
G0 Z10 F480 ; move away in Z

M106 S100 ; cool off the nozzle
M107 ; stop cooling off the nozzle - turn off the fan
; MBL
M84 E ; turn off E motor
G29 P1 ; invalidate mbl & probe print area
G29 P1 X30 Y0 W50 H20 C ; probe near purge place
G29 P3.2 ; interpolate mbl probes
G29 P3.13 ; extrapolate mbl outside probe area
G29 A ; activate mbl
M104 S220 ; set extruder temp
G1 Z10 F720 ; move away in Z
G0 X30 Y-8 F6000 ; move next to the sheet
; wait for extruder temp
M109 T0 S220
;
; purge
;
G92 E0 ; reset extruder position
G0 X30 Y-8 ; move close to the sheet's edge
M73 P3 R130
G1 E2 F2400 ; deretraction after the initial one before nozzle cleaning
G0 E10 X40 Z0.2 F500 ; purge
G0 X70 E9 F800 ; purge
G0 X73 Z0.05 F8000 ; wipe, move close to the bed
G0 X76 Z0.2 F8000 ; wipe, move quickly away from the bed
G92 E0 ; reset extruder position
G90
G21
M83 ; use relative distances for extrusion
; filament start gcode
M900 K0.05 ; Filament gcode


M572 S0.036 ; Filament gcode


M142 S36 ; set heatbreak target temp
M106 S0
;LAYER_CHANGE
;Z:0.2
;HEIGHT:0.2
;BEFORE_LAYER_CHANGE
G92 E0.0
;0.2
G1 E-.8 F2100
;AFTER_LAYER_CHANGE
;0.2
;_SET_FAN_SPEED_CHANGING_LAYER
M204 P500
